{
  "name": "@a11ign/documents",
  "version": "0.1.0",
  "description": "The PDF layer (ADR 0036's second layer, #68): reads a PDF's own accessibility tag tree -- tagged/untagged, the document language, alt text on figures -- with no browser, no NVDA and no fleet.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11ign/documents.git"
  },
  "homepage": "https://github.com/a11ign/documents",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "pdf"
  ],
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run typecheck",
    "test": "rstest run",
    "layout-check": "node node_modules/@a11ign/toolchain/dist/layout-check.mjs",
    "smoke": "node scripts/pack-smoke.mjs",
    "prepack": "rslib build"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@a11ign/toolchain": "0.1.5",
    "@changesets/cli": "3.0.3",
    "@rslib/core": "^1.0.3",
    "@rstest/core": "^0.12.3",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  }
}
